# Dockerfile.plugin — multi-stage build for the Console Plugin binary.
#
# Stage 1: Build the React Console Plugin assets.
# Stage 2: Build the Go plugin binary with embedded UI.
# Stage 3: Minimal distroless runtime image.
#
# To rebuild after UI changes:
#   make docker-build-plugin IMG_PLUGIN=<registry>/<image>:<tag>

FROM --platform=$BUILDPLATFORM registry.access.redhat.com/hi/nodejs:26-builder AS ui-build
USER root
WORKDIR /app
ARG CONSOLE_VERSION=4.19
ENV CONSOLE_VERSION=${CONSOLE_VERSION}
COPY ui/package.json ui/package-lock.json* ./ui/
RUN npm --prefix ui ci --ignore-scripts

COPY ui/ ./ui/
RUN npm --prefix ui run install:console-profile
# Build the OpenShift Console Plugin assets.
RUN npm --prefix ui run build:plugin

# -----------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.27.1@sha256:162be5298a40ed317005c8339c6de4d10d3eef336d66dc8e9259b03ab9d3a6d2 AS go-build
ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace

COPY go.mod go.mod
COPY go.sum go.sum
RUN go mod download

COPY cmd/ cmd/
COPY api/ api/
COPY pkg/ pkg/
COPY internal/ internal/

# Replace the placeholder embedded UI with the React build output.
COPY --from=ui-build /app/ui/dist/plugin/ pkg/resourceapi/plugin/

RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} \
    go build -a -o plugin ./cmd/dashboard/

# -----------------------------------------------------------------------
FROM gcr.io/distroless/static:nonroot@sha256:e2e927ec666bae08560abb3c55d0659eceabb657f56b6782ab500a9fc7f555e3
WORKDIR /
COPY --from=go-build /workspace/plugin .
USER 65532:65532

ENTRYPOINT ["/plugin"]
