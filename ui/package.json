{
  "name": "oc-mirror-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:plugin": "node scripts/build-plugin.mjs",
    "build": "npm run build:plugin",
    "install:console-profile": "node scripts/install-console-profile.mjs",
    "start:plugin": "webpack serve --config webpack.plugin.js --mode development",
    "dev": "webpack serve --config webpack.dev.js",
    "dev:mock": "webpack serve --config webpack.dev.js --env mock=true",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "jest"
  },
  "consolePlugin": {
    "name": "oc-mirror-operator",
    "version": "0.1.0",
    "displayName": "OC Mirror",
    "description": "Manage OC Mirror Operator ImageSets and MirrorTargets from the OpenShift Console",
    "exposedModules": {
      "MirrorTargetListPage": "./plugin/pages/MirrorTargetListPage",
      "MirrorTargetDetailPage": "./plugin/pages/MirrorTargetDetailPage",
      "FailedImagesPage": "./plugin/pages/FailedImagesPage",
      "FailedImagesAllPage": "./plugin/pages/FailedImagesAllPage",
      "CatalogBrowserPage": "./plugin/pages/CatalogBrowserPage",
      "ImageSetListPage": "./plugin/pages/ImageSetListPage",
      "ImageSetDetailPage": "./plugin/pages/ImageSetDetailPage"
    },
    "dependencies": {
      "@console/pluginAPI": "*"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@openshift-console/dynamic-plugin-sdk": "5.0-latest",
    "@openshift-console/dynamic-plugin-sdk-webpack": "5.0-latest",
    "@patternfly/react-core": "6.7.0",
    "@patternfly/react-icons": "6.7.0",
    "@patternfly/react-table": "6.7.0",
    "@rspack/cli": "^2.2.9",
    "@rspack/core": "^2.2.9",
    "@swc/core": "^1.16.20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-router-dom": "^5.3.3",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "globals": "^17.13.0",
    "mini-css-extract-plugin": "^2.9.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.7",
    "ts-checker-rspack-plugin": "^1.7.1",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.1",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  }
}
